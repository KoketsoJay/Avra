{
  "Urls": "http://localhost:5007",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5199" ]
  },
  "RateLimiting": {
    "PermitsPerMinute": 300,
    "AuthPermitsPerMinute": 10
  },
  "Jwt": {
    "Issuer": "avra-auth-service",
    "Audience": "avra-api",
    "AccessTokenMinutes": 60
  },
  "GracePeriodManager": {
    "GracePeriodTime": 1,
    "CheckUpdateTime": 15000
  },
  "EventBus": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=AvraEventBus;Trusted_Connection=true;Encrypt=false;",
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxDeliveryAttempts": 5,
    "Retention": "7.00:00:00"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AvraOrderingService;Trusted_Connection=true;Encrypt=false;"
  }
}
